<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btn_toggle"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:text="開始"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="今日播放 0　今日標記 0"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#33888888" />

        <TextView
            android:id="@+id/tv_gain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="旁白音量 0.80"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/sb_gain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80" />

        <Button
            android:id="@+id/btn_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="試播（讓音樂播著，邊聽邊調）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="在安靜環境校準出來的音量，套到有音樂的情境一定不對。請放著音樂按試播。"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#33888888" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="間隔分布（權重）"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_w1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="常態 120～240 秒　70" />

        <SeekBar
            android:id="@+id/sb_w1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/tv_w2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="連發 20～40 秒　20" />

        <SeekBar
            android:id="@+id/sb_w2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/tv_w3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="長靜默 300～420 秒　10" />

        <SeekBar
            android:id="@+id/sb_w3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#33888888" />

        <Button
            android:id="@+id/btn_timeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="播放時間軸（事後補標）" />

        <Button
            android:id="@+id/btn_review"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="待分類" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="設定與匯出" />

    </LinearLayout>
</ScrollView>
